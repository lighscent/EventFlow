{
  "behavior": {
    "oneCommitPerMessage": true,
    "showFileNames": false,
    "showCommitUrls": true,
    "showCommitMessageBody": false,
    "showCompareLink": true,
    "showFilesRecap": true,
    "onlyDefaultBranch": false
  },
  "limits": {
    "maxCommitsPerEmbed": 5,
    "maxEmbedsPerPush": 20,
    "maxFilesPerCommit": 10
  },
  "display": {
    "showRepoNameInTitle": true,
    "showBranchInTitle": true,
    "showCommitCountInTitle": true,
    "embedDescriptionSeparator": "\n\n",
    "fileListPrefix": "Files:"
  },
  "embed": {
    "embedColor": "7289DA",
    "footerText": "EventFlow by xl1te"
  },
  "author": {
    "showAuthorIcon": true,
    "useAuthorUrl": true,
    "authorUsePusher": true
  }
}
