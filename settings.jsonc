{
  "behavior": {
    "oneCommitPerMessage": true,
    "showFileNames": false,
    // Needs oneCommitPerMessage:false and showFileNames:true
    "showFilesRecap": false,
    "showCommitUrls": true,
    "showCommitMessageBody": false,
    "showCompareLink": true,
    "onlyDefaultBranch": false
  },
  "limits": {
    // Needs oneCommitPerMessage:false
    "maxCommitsPerEmbed": 5,
    "maxEmbedsPerPush": 20,
    // Needs showFileNames:true
    "maxFilesPerCommit": 10
  },
  "display": {
    "showRepoNameInTitle": true,
    "showBranchInTitle": true,
    "showCommitCountInTitle": true,
    "separator": "\n\n",
    "filePrefix": "Files:"
  },
  "embed": {
    "color": "7289DA",
    "footer": "EventFlow by xl1te"
  },
  "author": {
    "showIcon": true,
    "useUrl": true,
    "usePusher": true
  }
}
